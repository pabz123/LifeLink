<?xml version="1.0" encoding="utf-8"?>
<!-- Header of the Home list: hero card, urgent requests, and the heading of the record list.
     Added to the ListView in code with addHeaderView(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cardHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <FrameLayout
            android:layout_width="@dimen/ring_size"
            android:layout_height="@dimen/ring_size">

            <ug.lifelink.app.ui.EligibilityRingView
                android:id="@+id/ringProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand_on_primary"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRingLabel"
                    style="@style/LL.Text.OnPrimaryCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatusTitle"
                style="@style/LL.Text.OnPrimaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvStatusDetail"
                style="@style/LL.Text.OnPrimaryCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                android:id="@+id/tvBloodChip"
                style="@style/LL.Text.OnPrimaryCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_chip_hero"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_xs"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvUrgentHeader"
        style="@style/LL.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/urgent_header" />

    <TextView
        android:id="@+id/tvFeedStatus"
        style="@style/LL.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvLocationPrompt"
        style="@style/LL.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnLocation"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target"
        android:text="@string/location_allow"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvUrgentHint"
        style="@style/LL.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/llUrgent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:divider="@drawable/divider_space"
        android:orientation="vertical"
        android:showDividers="middle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvListHeader"
            style="@style/LL.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnAddRecord"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/action_add"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyRecords"
        style="@style/LL.Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/empty_records"
        android:visibility="gone" />
</LinearLayout>
